# Copy to server/.env for `docker compose`; never commit the real file.
#
# Pairing code: shared secret the operator hands to devices once. Pick
# something long and random (`openssl rand -base64 24`).
WHEEZPER_PAIRING_CODE=change-me-to-a-long-random-string
POSTGRES_USER=wheezper
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=wheezper
WHEEZPER_PORT=50051
RUST_LOG=info

# --- assistant (server-side; the phone never holds a model or a key) ---------
# Local Ollama on the host:
WHEEZPER_ASSISTANT_URL=http://host.docker.internal:11434
WHEEZPER_ASSISTANT_MODEL=gemma3:1b
# Ollama Cloud needs a key. Transcript text then leaves this machine; the
# server logs a warning at startup when the assistant URL is not localhost.
# WHEEZPER_ASSISTANT_URL=https://ollama.com/api
# OLLAMA_API_KEY=

# --- retention / TLS ---------------------------------------------------------
# Delete completed sessions older than N days (0 = keep forever).
WHEEZPER_RETENTION_DAYS=0
# Mount certs into the container to serve TLS directly:
# WHEEZPER_TLS_CERT=/certs/fullchain.pem
# WHEEZPER_TLS_KEY=/certs/privkey.pem
